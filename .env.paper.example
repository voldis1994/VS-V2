# VS-V2 PAPER deployment — copy to .env.paper and fill secrets.
# HARD RULES: OPERATING_MODE=PAPER, LIVE_TRADING_ENABLED=false, no broker orders.

# --- Fail-closed runtime (do not change for PAPER) ---
OPERATING_MODE=PAPER
LIVE_TRADING_ENABLED=false
MARKET_CORE_BRIDGE=true

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market_reader
DB_USER=market_reader
DB_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Security ---
MASTER_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_OR_BASE64_KEY_HERE
JWT_SECRET=CHANGE_ME_JWT_SECRET
API_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
# Local-only: allow CHANGE_ME admin token (never in shared/prod). Install.bat generates a real token.
ALLOW_INSECURE_ADMIN=false
PIPELINE_TOKEN=CHANGE_ME_PIPELINE_TOKEN
PIPELINE_SERVICE_TOKEN=

# --- Control API ---
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=3000
CONTROL_API_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:5173
CLIENT_CORS_ORIGIN=http://localhost:5173
CLIENT_COOKIE_SECURE=false
TRUST_PROXY=false

# --- Market Core ---
MARKET_CORE_HOST=localhost
MARKET_CORE_PORT=9100
MARKET_CORE_URL=http://127.0.0.1:9100
MARKET_CORE_CONFIG_DIR=./config
# PAPER uses --mode PAPER (set by scripts/start-paper.sh). Never pass --mode LIVE/SHADOW here.

# --- Capital.com LIVE market data (quotes/OHLC only; orders forbidden in PAPER) ---
CAPITAL_API_KEY=
CAPITAL_API_PASSWORD=
CAPITAL_IDENTIFIER=
CAPITAL_EPIC=
# Live market-data endpoint (not demo). Override only if Capital provides a different host.
CAPITAL_BASE_URL=https://api-capital.backend-capital.com
CAPITAL_ENVIRONMENT=live

# --- Optional model (observation only in PAPER) ---
# VS_V2_MODEL_PATH=
# VS_V2_MODEL_ID=
# VS_V2_MODEL_VERSION=

# --- Logging / Dashboard ---
LOG_LEVEL=info
LOG_DIR=./logs
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
