{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MarketTick",
  "type": "object",
  "required": [
    "instrument_id",
    "bid",
    "ask",
    "timestamp"
  ],
  "properties": {
    "instrument_id": {
      "type": "integer"
    },
    "bid": {
      "type": "number"
    },
    "ask": {
      "type": "number"
    },
    "timestamp": {
      "type": "string"
    }
  }
}
