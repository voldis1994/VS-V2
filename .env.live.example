# VS-V2 LIVE deployment — copy to .env.live and fill secrets.
# REAL Capital.com broker open/close when LIVE.bat / start-live.sh confirms.

# --- LIVE runtime (required) ---
OPERATING_MODE=LIVE
LIVE_TRADING_ENABLED=true
MARKET_CORE_BRIDGE=true

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market_reader
DB_USER=market_reader
DB_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Security ---
MASTER_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_OR_BASE64_KEY_HERE
JWT_SECRET=CHANGE_ME_JWT_SECRET
API_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
ALLOW_INSECURE_ADMIN=false
PIPELINE_TOKEN=CHANGE_ME_PIPELINE_TOKEN
PIPELINE_SERVICE_TOKEN=

# --- Control API ---
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=3000
CONTROL_API_URL=http://127.0.0.1:3000
# Admin Control Panel (Vite :5173)
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Public Client Web gateway (:5174). For remote clients replace with your HTTPS origin:
# CLIENT_CORS_ORIGIN=https://clients.example.com,https://xxxx.trycloudflare.com
CLIENT_CORS_ORIGIN=http://127.0.0.1:5174,http://localhost:5174
CLIENT_COOKIE_SECURE=true
TRUST_PROXY=true
CLIENT_PUBLIC_PORT=5174
# Shareable homepage for clients (shown + copyable on Control Panel → Clients).
# Update when Cloudflare tunnel / domain changes — or edit in Control Panel.
# CLIENT_PUBLIC_URL=https://clients.example.com

# --- Market Core ---
MARKET_CORE_HOST=localhost
MARKET_CORE_PORT=9100
MARKET_CORE_URL=http://127.0.0.1:9100
MARKET_CORE_CONFIG_DIR=./config
# LIVE.bat / start-live.sh starts market-core --mode LIVE (CapitalOrderGateway bound).

# --- Capital.com LIVE credentials (REQUIRED for LIVE.bat) ---
CAPITAL_API_KEY=
CAPITAL_API_PASSWORD=
CAPITAL_IDENTIFIER=
CAPITAL_EPIC=
CAPITAL_BASE_URL=https://api-capital.backend-capital.com
CAPITAL_ENVIRONMENT=live

# --- Optional production model ---
# VS_V2_MODEL_PATH=
# VS_V2_MODEL_ID=
# VS_V2_MODEL_VERSION=

# --- Logging / Dashboard ---
LOG_LEVEL=info
LOG_DIR=./logs
VITE_API_URL=
VITE_WS_URL=ws://127.0.0.1:3000/ws
